{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atsumi",
  "version": "1.9.0",
  "identifier": "local.atsumi.next",
  "build": {
    "beforeDevCommand": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./tools/run_frontend.ps1 dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./tools/run_frontend.ps1 build",
    "frontendDist": "../dist"
  },
  "app": {
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.ico",
      "tooltip": "Atsumi",
      "showMenuOnLeftClick": false
    },
    "windows": [
      {
        "label": "main",
        "title": "Atsumi",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "frame-src": "atsumi-player://localhost http://atsumi-player.localhost https://atsumi-player.localhost",
        "img-src": "'self' blob: data: detail-original://localhost http://detail-original.localhost danbooru-media://localhost http://danbooru-media.localhost atsumi-replay://localhost http://atsumi-replay.localhost https://atsumi-replay.localhost",
        "media-src": "'self' blob: data: https://cdn.donmai.us atsumi-replay://localhost http://atsumi-replay.localhost https://atsumi-replay.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../.runtime/media-tools/ffmpeg-n9.0.1-29-gad500d59cb-win64-lgpl-shared-9.0/": "media-tools/"
    },
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMDFDRjhFQTQ3QzVBNUEKUldSYVdueWtqczhCOGhTRko3SzdwOTBRNTYzQlhsK1ZKSG1GV2x2dldOT3lWVGdkaWZoeWJjTHcK",
      "endpoints": [
        "https://github.com/assesse/Atsumi-Project/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
